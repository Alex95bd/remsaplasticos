# Copia este archivo como .env y ajusta los valores

# Identidad del sitio
APP_NAME=Remsa Plásticos
APP_TAGLINE=Envases de PET, PEAD y PVC para la industria

# Base de datos (SQLite por defecto; para PostgreSQL usa
# postgresql+psycopg://usuario:password@host:5432/remsa)
DATABASE_URL=sqlite:///./remsa.db

# Cambia SIEMPRE esta llave en producción (firma las cookies del panel)
SECRET_KEY=cambia-esta-llave-en-produccion

# Acceso al panel interno (/admin). Cambia la contraseña antes de publicar.
ADMIN_EMAIL=admin@remsa.com.mx
ADMIN_PASSWORD=admin123

# Datos de contacto que se muestran en el sitio
COMPANY_PHONE=(999) 941 0145
COMPANY_PHONE_ALT=(999) 941 0147
COMPANY_EMAIL=contacto@remsa.com.mx
COMPANY_WHATSAPP=529999410145

# Chatbot: opcional. Sin llave funciona el motor local de intenciones.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
