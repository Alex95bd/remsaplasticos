# REMSA Gestión Comercial — copia este archivo como .env y ajusta los valores.
# Nunca subas el archivo .env al repositorio.

# Desarrollo: True. Producción: False (obligatorio).
DJANGO_DEBUG=True
# Genera una llave con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes HTTPS desde los que se envían formularios (producción), separados por coma.
# Ej. https://gestion.remsa.com.mx
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/Merida
# Ruta del panel técnico de Django (solo superusuarios).
DJANGO_ADMIN_URL=django-admin/

# Seguridad en producción (detrás de HTTPS)
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_BEHIND_PROXY=False

# Base de datos: sqlite (desarrollo) o postgres (producción)
DB_ENGINE=sqlite
# SQLITE_PATH=gestion.sqlite3
POSTGRES_DB=remsa_gestion
POSTGRES_USER=remsa
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Correo para recuperación de contraseña. En desarrollo se muestra en la consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=REMSA Gestión Comercial <no-responder@remsa.com.mx>

DJANGO_LOG_LEVEL=INFO
CATALOG_IMPORT_MAX_ROWS=2000

# Clientes/proveedores: campos que no pueden repetirse (rfc, nombre, correo)
CRM_DUPLICATE_RULES=rfc,nombre
# Cotizaciones
QUOTE_DEFAULT_VALIDITY_DAYS=15
QUOTE_DEFAULT_TAX_RATE=16
# Descuento máximo por partida sin permiso de autorización (%)
QUOTE_MAX_DISCOUNT_PCT=10
# Inventario: permitir existencias negativas (no recomendado)
INVENTORY_ALLOW_NEGATIVE=False
